rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 24-hour ephemeral ingestion documents
    match /ephemeral/{userId}/{allPaths=**} {
      // Allow read, write (create, update, delete) up to 25MB per document
      allow read: if true;
      allow write: if request.resource == null || request.resource.size < 25 * 1024 * 1024;
    }

    // Default rule for all other files
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
