rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // API Keys (Only owner can read, create, or update status)
    match /api_keys/{keyId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow delete: if false; // Prefer revoking rather than hard deletion
    }

    // Usage Logs (Read only for the key owner)
    match /usage_logs/{logId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Written exclusively by Cloud Functions backend
    }

    // Extraction Queue (Read only for the job owner)
    match /extraction_queue/{jobId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow write: if false; // Managed exclusively by Cloud Functions backend
    }
  }
}
