{
  "name": "paralux-extract-functions",
  "description": "Cloud Functions Backend for Paralux Extract AI",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsc && node lib/dev.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "emulators": "npm run build && firebase emulators:start",
    "deploy": "firebase deploy --only functions",
    "start": "npm run dev"
  },
  "dependencies": {
    "@google/adk": "^1.3.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^6.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  }
}
