# ==============================================================================
# Paralux Extract AI - Cloud Functions Backend Environment Configuration
# ==============================================================================
# Copy this file to '.env' (or '.env.local') in the functions directory and fill
# in your valid API keys and environment parameters.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Models & Credentials
# ------------------------------------------------------------------------------
# Get your Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# Mode 1: Cheap, high-speed document extraction (1 credit per 1-5 pages)
# Recommended: Gemini 3.5 / Flash-Lite / 2.5 Flash
GEMINI_MODE_1_MODEL=gemini-2.5-flash

# Mode 2: High intelligence, deep multimodal vision & complex tables (2 credits per 1-5 pages)
# Recommended: Gemini 3.7 / 3.7 Flash / 3.7 Pro
GEMINI_MODE_2_MODEL=gemini-3.7-flash

# ------------------------------------------------------------------------------
# 2. Firebase & Google Cloud Storage Configuration
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=paralux-extract
FIREBASE_STORAGE_BUCKET=paralux-extract.firebasestorage.app
GCP_REGION=us-central1

# ------------------------------------------------------------------------------
# 3. Server, Quota & Execution Parameters
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
MAX_PAYLOAD_SIZE=50mb
DEFAULT_FREE_CREDITS=50

# ------------------------------------------------------------------------------
# 4. Optional Stripe / Billing Configuration (If enabled)
# ------------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
